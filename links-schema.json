{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://tailstory.wiki/links-schema.json",
    "title": "Tailstory wiki product links",
    "type": "object",
    "additionalProperties": false,
    "required": ["links"],
    "properties": {
        "links": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "href"],
                "properties": {
                    "title": { "type": "string", "minLength": 1 },
                    "href": { "type": "string", "pattern": "^https://" }
                }
            }
        }
    }
}
