<article class="doc-content"{% if pageTopic %} data-tsy-topic="{{ pageTopic }}"{% endif %}>
{% include "doc-header.njk" %}
{{ content | safe }}
{% set cardGroups = page.inputPath | landingCardGroups %}
{% if cardGroups and cardGroups.length %}
<nav class="card-groups" aria-label="Pages in this section">
{% for group in cardGroups %}
<section class="card-group">
{% if group.heading %}<h2 class="card-group-title">{{ group.heading }}</h2>{% endif %}
<div class="card-grid">
{% for card in group.cards %}
<a class="card" href="{{ card.href }}">
<h3 class="card-title">{{ card.title }}</h3>
{% if card.description %}<p class="card-desc">{{ card.description }}</p>{% endif %}
</a>
{% endfor %}
</div>
</section>
{% endfor %}
</nav>
{% endif %}
</article>
